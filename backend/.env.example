DATABASE_URL=postgresql://user:password@localhost/ai_news

OPENAI_API_KEY=
OPENAI_BASE_URL=
CONTENT_ANALYZER_MODEL=

# FastAPI: set in production to protect POST /api/v1/sources/* and /api/v1/jobs/aggregate
API_KEY=

API_HOST=0.0.0.0
API_PORT=8000

# Web UI lives in a separate folder next to this repo: ../ai-news-web (npm run dev).
# CORS must list the Vite origin if the UI calls the API directly (not via Vite proxy).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Brevo (formerly Sendinblue) transactional email.
# Digests are sent via the Brevo API. BREVO_SENDER_EMAIL must be a verified sender;
# if left empty it falls back to ADMIN_EMAIL.
BREVO_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=AIPulse

SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
CUSTOM_FETCH_HOUR=8

# On API startup, upsert default RSS/YouTube rows from ai_news_aggregater/data/default_sources.py
SYNC_DEFAULT_SOURCES_ON_STARTUP=false

AGGREGATION_LOOKBACK_HOURS=24
AGGREGATION_RSS_PER_FEED_LIMIT=20

# GitHub trending AI repositories (fetched daily as part of the aggregation run).
# Optional personal access token raises the search rate limit (30/min vs 10/min).
GITHUB_TOKEN=
# Comma-separated topics for the trending search.
GITHUB_AI_TOPICS=ai,llm,machine-learning,deep-learning,agents
# Max repos stored per run.
AGGREGATION_GITHUB_LIMIT=5
# Only repos created in the last N days count as trending.
AGGREGATION_GITHUB_LOOKBACK_DAYS=7
